# Copy to .env for local work. Never commit the filled-in file.

ENV=local
DEBUG=true
APP_NAME=MediKiosk API
API_V1_PREFIX=/api/v1

# openssl rand -hex 32
SECRET_KEY=dev-only-change-me

# Vite dev server, then your deployed frontend origin. Comma separated, never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local docker-compose Postgres. For AWS RDS:
# postgresql+asyncpg://medikiosk:PASSWORD@your-db.abc123.ap-south-1.rds.amazonaws.com:5432/medikiosk
DATABASE_URL=postgresql+asyncpg://medikiosk:medikiosk@localhost:5432/medikiosk

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT=8/minute

# Providers. Every one defaults to an offline adapter, so the API runs
# end to end with no keys and no network at all.
AI_PROVIDER=mock            # mock | gemini
OCR_PROVIDER=mock           # mock | tesseract
STORAGE_PROVIDER=local      # local | s3
SPEECH_PROVIDER=browser
ABDM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

TESSERACT_LANGS=eng+hin+kan

LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=ap-south-1
# Leave these empty on ECS or App Runner — the task role supplies credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_BYTES=10485760

# Must be false in production; config.py refuses to start otherwise.
ALLOW_DEMO_SEED=true
